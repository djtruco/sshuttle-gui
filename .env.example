# Remote: either an SSH alias / full target (from ~/.ssh/config)...
SSHUTTLE_REMOTE=
# ...or user + host (+ optional port, defaults to 22). Ignored if SSHUTTLE_REMOTE is set.
SSHUTTLE_USER=your_ssh_user
SSHUTTLE_HOST=your.ssh.host
SSHUTTLE_PORT=
# Comma-separated subnets to route through the tunnel; defaults to 0/0
SSHUTTLE_SUBNETS=10.0.0.0/24,192.168.1.0/24
# Comma-separated subnets/IPs to exclude (-x)
SSHUTTLE_EXCLUDE=
# Forward DNS through the tunnel (--dns); default true
SSHUTTLE_DNS=true
